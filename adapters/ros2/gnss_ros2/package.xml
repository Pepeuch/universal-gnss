<?xml version="1.0"?>
<package format="3">
  <name>universal_gnss_ros2</name>
  <version>0.7.0</version>
  <description>ROS 2 adapters and messages for the Universal GNSS core runtime model.</description>
  <maintainer email="opensource@example.com">Universal GNSS</maintainer>
  <license>LGPL-3.0-or-later</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>builtin_interfaces</depend>
  <depend>diagnostic_msgs</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>universal_gnss_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
