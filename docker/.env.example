# Keep a real env file outside the repository and pass it with:
# docker compose --env-file /srv/universal-gnss/compose.env -f docker/compose.yaml up -d
UNIVERSAL_GNSS_IMAGE=universal-gnss:ros2-kilted-v0.7.0
GNSS_DEVICE=/dev/serial/by-id/usb-example
GNSS_GROUP=20
UNIVERSAL_GNSS_PARAMETERS_FILE=/srv/universal-gnss/parameters.yaml
UNIVERSAL_GNSS_LOG_DIR=/srv/universal-gnss/log
ROS_DOMAIN_ID=42
